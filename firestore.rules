// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: fairshare_groups
// Document ID: groupId (prefixed with 'cloud_')
// Fields:
//   - id: string (required, matching document ID) - Unique ID for the group
//   - name: string (required, 1-100 characters) - Group name
//   - currency: string (required, 1-10 characters) - Currency symbol/code (e.g. RM)
//   - members: list of strings (required, max 50 members) - Member names
//   - expenses: list of maps (required, max 1000 items) - Expenses list
//   - settlements: list of maps (required, max 1000 items) - Settlements list
//   - bankDetails: map of maps (required, max 50 items) - Member bank and QR code configurations
//   - updatedAt: number (required) - Millisecond timestamp of last edit
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fairshare_groups/{groupId} {
      allow read, write, delete: if true;
      
      match /{allPaths=**} {
        allow read, write, delete: if true;
      }
    }
  }
}
